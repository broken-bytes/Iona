module Hello

public class Greeter {
    public var x = 10
    public var y = 20
    public let max = 100

    public fn greet() -> Int32 {
        var sum = x + y
        return sum
    }

    public fn loop_test() -> Int32 {
        var total = 0
        for i in 0...4 {
            total = total + i
        }
        return total
    }

    public fn while_test() -> Int32 {
        var count = 0
        while count + 1 < max {
            count = count + 1
        }
        return count
    }

    public fn if_test() -> Int32 {
        let val = 42
        if val > 50 {
            return 1
        } else if val > 30 {
            return 2
        } else {
            return 3
        }
    }
}
