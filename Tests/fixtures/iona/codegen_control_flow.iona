module App

use System

fn main() -> Int32 {
    if 1 == 1 {
        printLn(message: "if-branch")
    } else {
        printLn(message: "else-branch")
    }

    for i in 0...2 {
        printLn(message: "${i}")
    }

    var n = 0
    while n < 4 {
        printLn(message: "${n}")
        n = n + 1
    }

    return 0
}
