<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Scope NuGet to nuget.org for this repo. <clear/> drops machine-global sources so the
    unrelated (and currently failing) private gitlab feed isn't consulted during restore.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="iona-local" value="local-feed" />
  </packageSources>
</configuration>
